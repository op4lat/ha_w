- sensor:
    - name: "ST Beaufort Scale"
      unique_id: st_beaufort_scale_number
      icon: mdi:weather-windy
      state_class: measurement
      state: >
        {% set wind = states('sensor.st_00187689_wind_speed') | float(0) %}
        {% if wind < 1.0 %}{% set bft = 0 %}
        {% elif wind < 4.0 %}{% set bft = 1 %}
        {% elif wind < 8.0 %}{% set bft = 2 %}
        {% elif wind < 13.0 %}{% set bft = 3 %}
        {% elif wind < 19.0 %}{% set bft = 4 %}
        {% elif wind < 25.0 %}{% set bft = 5 %}
        {% elif wind < 32.0 %}{% set bft = 6 %}
        {% elif wind < 39.0 %}{% set bft = 7 %}
        {% elif wind < 47.0 %}{% set bft = 8 %}
        {% elif wind < 55.0 %}{% set bft = 9 %}
        {% elif wind < 64.0 %}{% set bft = 10 %}
        {% elif wind < 73.0 %}{% set bft = 11 %}
        {% else %}{% set bft = 12 %}{% endif %}
        {{ bft }}

    - name: "ST Beaufort Description"
      unique_id: st_beaufort_scale_description
      icon: mdi:comment-text-outline
      state: >
        {% set bft = states('sensor.st_beaufort_scale') | int(0) %}
        {% set desc = {
          0: 'Calm', 1: 'Light air', 2: 'Light breeze', 3: 'Gentle breeze', 
          4: 'Moderate breeze', 5: 'Fresh breeze', 6: 'Strong breeze', 
          7: 'High wind', 8: 'Gale', 9: 'Strong gale', 10: 'Storm', 
          11: 'Violent storm', 12: 'Hurricane force'
        } %}
        {{ desc.get(bft, 'Unknown') }}

    - name: "ST Beaufort Land Conditions"
      unique_id: st_beaufort_scale_land
      icon: mdi:tree
      state: >
        {% set bft = states('sensor.st_beaufort_scale') | int(0) %}
        {% set land = {
          0: 'Smoke rises vertically.',
          1: 'Direction shown by smoke drift but not by wind vanes.',
          2: 'Wind felt on face; leaves rustle; wind vane moves.',
          3: 'Leaves and small twigs constant motion; light flags extended.',
          4: 'Raises dust and loose paper; small branches moved.',
          5: 'Small trees in leaf begin to sway; crested wavelets form on inland waters.',
          6: 'Large branches in motion; whistling heard in telegraph wires; umbrellas used with difficulty.',
          7: 'Whole trees in motion; inconvenience felt when walking against the wind.',
          8: 'Twigs break off trees; generally progresses impedes.',
          9: 'Slight structural damage occurs (chimney-pots and slates removed).',
          10: 'Seldom experienced inland; trees uprooted; considerable structural damage occurs.',
          11: 'Very rarely experienced; accompanied by widespread damage.',
          12: 'Devastation.'
        } %}
        {{ land.get(bft, 'Unknown') }}

    - name: "ST Beaufort Sea Conditions"
      unique_id: st_beaufort_scale_sea
      icon: mdi:waves
      state: >
        {% set bft = states('sensor.st_beaufort_scale') | int(0) %}
        {% set sea = {
          0: 'Sea like a mirror.',
          1: 'Ripples with appearance of scales are formed, without foam crests.',
          2: 'Small wavelets, still short but more pronounced; crests have a glassy appearance but do not break.',
          3: 'Large wavelets; crests begin to break; foam of glassy appearance; perhaps scattered white horses.',
          4: 'Small waves becoming longer; fairly frequent white horses.',
          5: 'Moderate waves taking a more pronounced long form; many white horses are formed.',
          6: 'Large waves begin to form; the white foam crests are more extensive everywhere.',
          7: 'Sea heaps up and white foam from breaking waves begins to be blown in streaks along the direction of the wind.',
          8: 'Moderately high waves of greater length; edges of crests break into spindrift.',
          9: 'High waves; dense streaks of foam along the direction of the wind; wave crests begin to topple, tumble and roll over.',
          10: 'Very high waves with long overhanging crests; foam in great patches blown in dense white streaks; sea surface takes on a white appearance.',
          11: 'Exceptionally high waves; small- and medium-sized ships might for a long time be lost to view behind the waves.',
          12: 'The air is filled with foam and spray; sea completely white with driving spray; visibility very seriously affected.'
        } %}
        {{ sea.get(bft, 'Unknown') }}
